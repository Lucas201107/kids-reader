  "lessons": [
    {
      "title": "My Family",
      "grade": 4,
      "unit": "Unit 1",
      "content": "This is my family. My father is a doctor. My mother is a teacher. I have a baby brother. He is very cute. I love my family.",
      "translation": "这是我的家。我爸爸是医生，妈妈是老师。我有一个小弟弟，他很可爱。我爱我的家。"
    },
    {
      "title": "My Day",
      "grade": 5,
      "unit": "Unit 2",
      "content": "I get up at seven o'clock. I go to school at eight. I have lunch at school. After school, I play football with my friends. I do my homework at seven in the evening.",
      "translation": "我七点起床，八点去上学，在学校吃午饭。放学后和朋友踢足球。晚上七点写作业。"
    },
    {
      "title": "Four Seasons",
      "grade": 6,
      "unit": "Unit 5",
      "content": "There are four seasons in a year. Spring is warm and green. Summer is hot and sunny. Autumn is cool and the leaves turn yellow. Winter is cold and snowy. I like autumn best.",
      "translation": "一年有四季。春天温暖翠绿，夏天炎热晴朗，秋天凉爽、树叶变黄，冬天寒冷多雪。我最喜欢秋天。"
    }
  ],

  "books": [
    {
      "title": "The Tortoise and the Hare",
      "grade": 3,
      "gradeTo": 5,
      "description": "经典伊索寓言：慢而稳者胜",
      "pages": [
        { "pageNo": 1, "text": "A hare laughs at a tortoise. \"You are so slow!\" says the hare.", "translation": "兔子嘲笑乌龟：“你太慢了！”" },
        { "pageNo": 2, "text": "\"Let's have a race,\" says the tortoise.", "translation": "乌龟说：“我们比赛吧。”" },
        { "pageNo": 3, "text": "The hare runs very fast. The tortoise walks slowly.", "translation": "兔子跑得飞快，乌龟慢慢地爬。" },
        { "pageNo": 4, "text": "Soon the hare is far ahead. He sits down under a tree.", "translation": "很快兔子遥遥领先，他坐在树下休息。" },
        { "pageNo": 5, "text": "\"The tortoise is so slow. I can sleep a little,\" says the hare.", "translation": "“乌龟太慢了，我可以睡一会儿。”兔子说。" },
        { "pageNo": 6, "text": "The tortoise keeps walking. He never stops.", "translation": "乌龟一直爬，从不停下。" },
        { "pageNo": 7, "text": "When the hare wakes up, the tortoise is near the finish line.", "translation": "兔子醒来时，乌龟已经接近终点。" },
        { "pageNo": 8, "text": "Slow and steady wins the race.", "translation": "稳扎稳打，终能取胜。" }
      ]
    },
    {
      "title": "The Lion and the Mouse",
      "grade": 4,
      "gradeTo": 6,
      "description": "小人物也能帮大忙",
      "pages": [
        { "pageNo": 1, "text": "A lion is sleeping in the forest.", "translation": "一只狮子在森林里睡觉。" },
        { "pageNo": 2, "text": "A little mouse runs over his nose.", "translation": "一只小老鼠从他鼻子上跑过。" },
        { "pageNo": 3, "text": "The lion catches the mouse. \"Please let me go!\" says the mouse.", "translation": "狮子抓住了老鼠。老鼠说：“请放了我吧！”" },
        { "pageNo": 4, "text": "The lion laughs and lets the mouse go.", "translation": "狮子笑着放走了老鼠。" },
        { "pageNo": 5, "text": "One day, the lion is caught in a net.", "translation": "一天，狮子被网困住了。" },
        { "pageNo": 6, "text": "The mouse cuts the net with his teeth.", "translation": "老鼠用牙齿咬断了网。" },
        { "pageNo": 7, "text": "\"Thank you, little friend,\" says the lion.", "translation": "狮子说：“谢谢你，小个子朋友。”" }
      ]
    },
    {
      "title": "The Ant and the Dove",
      "grade": 3,
      "gradeTo": 5,
      "description": "互相帮助的故事",
      "pages": [
        { "pageNo": 1, "text": "An ant is drinking water by the river.", "translation": "一只蚂蚁在河边喝水。" },
        { "pageNo": 2, "text": "Oh no! The ant falls into the water.", "translation": "哎呀！蚂蚁掉进了水里。" },
        { "pageNo": 3, "text": "A dove sees the ant and drops a leaf.", "translation": "鸽子看见蚂蚁，扔下一片叶子。" },
        { "pageNo": 4, "text": "The ant climbs onto the leaf and is safe.", "translation": "蚂蚁爬上叶子，安全了。" },
        { "pageNo": 5, "text": "Later, a boy wants to catch the dove.", "translation": "后来，一个男孩想捉住鸽子。" },
        { "pageNo": 6, "text": "The ant bites the boy's foot. The dove flies away.", "translation": "蚂蚁咬了男孩的脚，鸽子飞走了。" }
      ]
    }
  ]
}
