# ============================================================
# 生产环境配置模板
# 用法：复制到 server/.env 并逐项填写真实值
#   cp deploy/.env.production.example server/.env
# ============================================================

# ---------- 服务基础 ----------
NODE_ENV=production
PORT=3000

# SQLite（默认，单文件零运维）
DATABASE_URL="file:./prod.db"
# 若改用 MySQL，把 prisma/schema.prisma 的 provider 改成 "mysql"，并改为：
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/kids_reader"

# 对外域名（末尾不要带斜杠）。音频 URL 会基于它生成，必须公网可访问，
# 否则腾讯云 SOE 拿不到音频文件。
PUBLIC_BASE_URL=https://api.你的域名.com

UPLOAD_DIR=./uploads

# ---------- 微信小程序 ----------
# 微信公众平台 → 开发管理 → 开发设置
WECHAT_APPID=wx你的AppID
WECHAT_SECRET=你的AppSecret

# ---------- JWT ----------
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=请替换为32字节随机字符串
JWT_EXPIRES_IN=30d

# ---------- 腾讯云：发音评测 SOE + 文字识别 OCR ----------
# 控制台 https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=AKID你的SecretId
TENCENT_SECRET_KEY=你的SecretKey
TENCENT_REGION=ap-guangzhou

# 上线后务必改为 false，否则所有评测都是模拟分数！
MOCK_SOE=false

# 单词发音分低于此值判为「需纠正」（0-100）
SOE_WORD_SCORE_THRESHOLD=60

# 每个学生每天最多跟读次数（0 = 不限制）。用于控制 SOE 费用：
# 40 人 × 每天 20 次 × 30 天 ≈ 2.4 万次，按 0.02 元/次约 480 元/月
DAILY_LIMIT=20

# ---------- 管理后台 & 老师身份 ----------
# 上线前必须改掉默认值！
ADMIN_USER=改成你自己的账号
ADMIN_PASS=改成强密码
TEACHER_INVITE_CODE=改成只有老师知道的邀请码
