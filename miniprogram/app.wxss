page {
  background: #f5f7fa;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #22262f;
  font-size: 28rpx;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 139, 245, 0.06);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.sub {
  font-size: 24rpx;
  color: #8a94a6;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.btn {
  background: #4c8bf5;
  color: #fff;
  border-radius: 44rpx;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
}

.btn.ghost {
  background: #fff;
  color: #4c8bf5;
  border: 2rpx solid #4c8bf5;
}

.btn.gray {
  background: #eef1f6;
  color: #8a94a6;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #eaf1ff;
  color: #4c8bf5;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.empty {
  text-align: center;
  color: #a8b0bf;
  padding: 80rpx 0;
  font-size: 26rpx;
}

/* 跟读逐词纠错配色 */
.w {
  display: inline-block;
  padding: 4rpx 8rpx;
  margin: 4rpx 6rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  line-height: 1.6;
}
.w-ok {
  color: #1f9254;
  background: #e8f6ee;
}
.w-warn {
  color: #b26a00;
  background: #fdf3e2;
}
.w-bad {
  color: #c0392b;
  background: #fdeceb;
  text-decoration: underline wavy #e0705f;
}
.w-miss {
  color: #8a94a6;
  background: #eef1f6;
  text-decoration: line-through;
}
