.head {
  background: linear-gradient(120deg, #4c8bf5, #6aa1ff);
}
.head .hello {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}
.head .sub {
  color: rgba(255, 255, 255, 0.85);
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
  text-align: center;
  line-height: 88rpx;
  font-size: 36rpx;
}
.input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
}
.join {
  margin-left: 16rpx;
  background: #4c8bf5;
  color: #fff;
  padding: 18rpx 32rpx;
  border-radius: 12rpx;
}
.task {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f3f8;
}
.task-title {
  font-size: 30rpx;
  margin-left: 12rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #f0a500;
}
.dot.done {
  background: #1f9254;
}
.quick {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.q {
  width: 23%;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 139, 245, 0.06);
}
.q-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 24rpx;
  color: #4c8bf5;
  font-weight: 600;
  margin: 0 auto 12rpx;
}
.stat {
  flex: 1;
  text-align: center;
}
.num {
  font-size: 40rpx;
  font-weight: 600;
  color: #4c8bf5;
}
.bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 180rpx;
  margin-top: 30rpx;
}
.bar-col {
  flex: 1;
  text-align: center;
}
.bar {
  width: 40rpx;
  margin: 0 auto;
  background: #9dc0ff;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 6rpx;
}
.bar-label {
  font-size: 20rpx;
  color: #a8b0bf;
  margin-top: 8rpx;
}
