.hero {
  text-align: center;
  padding: 60rpx 0 30rpx;
}
.logo {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  border-radius: 40rpx;
  background: #4c8bf5;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  margin: 0 auto 24rpx;
}
.h1 {
  font-size: 40rpx;
  font-weight: 600;
}
.sub {
  color: #8a94a6;
  font-size: 26rpx;
  margin-top: 10rpx;
}
.label {
  font-size: 26rpx;
  color: #5f6b7f;
  margin: 24rpx 0 12rpx;
}
.input {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
}
.pick {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #f1f3f8;
  color: #5f6b7f;
  margin-right: 16rpx;
  font-size: 26rpx;
}
.pick.on {
  background: #4c8bf5;
  color: #fff;
}
.tip {
  text-align: center;
  color: #a8b0bf;
  font-size: 22rpx;
  margin-top: 20rpx;
}
