# ============================================================
# 孩子英语绘本跟读纠错系统 —— 环境变量模板
# 使用：cp .env.example .env  然后逐项填写
# 注意：.env 已被 .gitignore 排除，千万不要把真实密钥提交到仓库
# ============================================================

# ===== 服务基础 =====
PORT=3000
NODE_ENV=development
# SQLite：file:./dev.db ；MySQL：mysql://root:密码@localhost:3306/kids_reader
DATABASE_URL="file:./dev.db"
# 对外可访问的域名（末尾不要带斜杠）。音频/图片 URL 都基于它拼接；
# 腾讯云 SOE 需要能从这个地址下载到录音，所以必须是公网可访问的 HTTPS
PUBLIC_BASE_URL=https://api.yourdomain.com
# 上传文件存放目录（需保证进程有写权限），Nginx 需把 /static 指向该目录
UPLOAD_DIR=./uploads

# ===== 微信小程序 =====
# 微信公众平台 → 开发管理 → 开发设置 获取
WECHAT_APPID=wxXXXXXXXXXXXX
WECHAT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ===== JWT =====
# 生产环境务必换成足够长的随机串：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ===== 腾讯云（发音评测 SOE + OCR）=====
# 控制台 https://console.cloud.tencent.com/cam/capi 获取
TENCENT_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxxxxxxxxxx
TENCENT_REGION=ap-guangzhou

# 评测模式：word 单词 / sentence 句子 / paragraph 段落 / free 自由说
SOE_EVAL_MODE=sentence
# 发音分低于该值的词判定为“需纠正”，范围 0-100
SOE_WORD_SCORE_THRESHOLD=60

# 未配置腾讯云密钥时是否使用模拟评测结果（本地开发用，方便先跑通流程）
# 配好真实密钥后改为 false 即切换真实评测
MOCK_SOE=true

# 每个学生每天最多跟读次数（0 = 不限制），用于控制发音评测费用
# 参考：40 人班每人每天 2 次约 240 次/月，可按预算调到 3~5
DAILY_LIMIT=0

# ===== 管理后台 / 老师权限 =====
# 老师 Web 管理后台登录账号（访问 http://域名/admin/index.html）
ADMIN_USER=admin
ADMIN_PASS=change-me-please
# 学生升级为老师时需要输入的邀请码，防止学生自己变成老师
TEACHER_INVITE_CODE=change-me-too
