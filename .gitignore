server/uploads/*
!server/uploads/.gitkeep
!server/uploads/audio/
!server/uploads/image/
!server/uploads/templates/
!server/uploads/file/
server/uploads/audio/*
server/uploads/image/*
server/uploads/templates/*
server/uploads/file/*
