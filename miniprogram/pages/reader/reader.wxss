.pic {
  width: 100%;
  border-radius: 16rpx;
  margin: 16rpx 0;
}
.text-box {
  background: #f8fafd;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 20rpx;
  font-size: 34rpx;
  line-height: 1.9;
}
.plain {
  color: #22262f;
}
.trans {
  color: #8a94a6;
  font-size: 26rpx;
  margin-top: 16rpx;
}
.ops {
  margin-top: 20rpx;
}
.mini-btn {
  background: #eaf1ff;
  color: #4c8bf5;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}
.mic-wrap {
  text-align: center;
  padding: 40rpx 0;
}
.mic {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #4c8bf5;
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(76, 139, 245, 0.35);
}
.mic.on {
  background: #e0705f;
  box-shadow: 0 12rpx 30rpx rgba(224, 112, 95, 0.35);
}
.mic-text {
  font-size: 34rpx;
  font-weight: 600;
}
.mic-sub {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}
.score-card {
  text-align: center;
}
.score {
  font-size: 88rpx;
  font-weight: 700;
  color: #4c8bf5;
  line-height: 1.1;
}
.dims {
  margin-top: 24rpx;
}
.dim {
  flex: 1;
  text-align: center;
}
.d-num {
  font-size: 34rpx;
  font-weight: 600;
}
.bad {
  background: #fdeceb;
  color: #c0392b;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  margin: 8rpx 12rpx 0 0;
  font-size: 28rpx;
}
.btns {
  margin-top: 24rpx;
}
.tip-line {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #b26a00;
  background: #fdf3e2;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
}
