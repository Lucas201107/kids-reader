# 默认按文本处理，统一在仓库内使用 LF 换行
* text=auto eol=lf

# Shell 脚本必须是 LF，否则在 Linux 服务器上会报 "bad interpreter"
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.xlsx binary
*.mp3 binary
*.wav binary
*.pdf binary
*.db binary
*.zip binary

# 让 GitHub 语言统计更准确：不把 .wxml/.wxss 当普通文本统计
*.wxml linguist-language=HTML
*.wxss linguist-language=CSS
